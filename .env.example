# Application Configuration
APP_NAME=ingestly
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# PostgreSQL (required)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=event_pipeline
DATABASE_URL=postgresql+asyncpg://postgres:change-me-postgres-password@localhost:5432/event_pipeline

# RabbitMQ (required)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
RABBITMQ_URL=amqp://guest:change-me-rabbitmq-password@localhost:5672/

# Queue Names & Retry Tiers
EVENTS_QUEUE=events.inbound
EVENTS_RETRY=events.retry
EVENTS_DLQ=events.dlq
MAX_RETRIES=3
RETRY_DELAYS_SECONDS=5,30,300
WORKER_SHUTDOWN_TIMEOUT_SECONDS=15.0

# Security & Rate Limiting (required - no defaults)
WEBHOOK_SECRET=change-me-webhook-secret
INGEST_API_KEY=change-me-ingest-key
REPLAY_API_KEY=change-me-admin-key
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
MAX_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Grafana (required for Docker Compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Retention Policy
OUTBOX_RETENTION_HOURS=24
RAW_EVENT_RETENTION_DAYS=7
ENABLE_AUTO_RETENTION=true
